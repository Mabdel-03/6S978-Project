Bootstrap: docker
From: python:3.12-slim-bookworm

# Sandbox image for every Harbor trial (Harbor `singularity` environment, CPU only).
# Build from the repo root:  apptainer build --fakeroot $SIF containers/bio-sandbox.def
#
# Constraints baked in here:
#  * ORCD caps the writable tmpfs at 64 MB (sessiondir max size), so NOTHING may be installed at
#    trial start: Harbor's bootstrap skips its pip/apt steps when /opt/harbor-server already imports
#    fastapi+uvicorn and apt has no sources; mini-swe-agent is pre-installed (agents use skip_install).
#  * /usr/bin/python3 must exist (Harbor bootstrap).
#  * No `datasets` in the agent-visible Python, no HF token; outbound HTTP is additionally blocked at
#    run time by a dead proxy (task.toml env) -- labels must stay unreachable.

%files
    src/dnaharness/runtime /opt/dnah/dnah_runtime

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends tmux asciinema ca-certificates procps bash coreutils
    rm -rf /var/lib/apt/lists/*

    ln -sf /usr/local/bin/python3 /usr/bin/python3

    # Harbor exec server venv (pre-baked; bootstrap.sh then installs nothing)
    /usr/local/bin/python3 -m venv /opt/harbor-server
    /opt/harbor-server/bin/pip install --no-cache-dir uvicorn fastapi

    # Agent-visible Python: rlms + numpy (+ openai via rlms). Pinned.
    /usr/local/bin/pip install --no-cache-dir "rlms==0.1.3" "numpy<3"

    # Off-the-shelf mini-swe-agent in its own venv; only its CLI is on PATH.
    /usr/local/bin/python3 -m venv /opt/mswea
    /opt/mswea/bin/pip install --no-cache-dir "mini-swe-agent==2.4.6" "litellm[mcp]" orjson fastapi
    ln -sf /opt/mswea/bin/mini-swe-agent /usr/local/bin/mini-swe-agent

    # Empty apt sources: bootstrap's `apt-get update` becomes a no-op (no tmpfs writes).
    rm -f /etc/apt/sources.list && rm -rf /etc/apt/sources.list.d && mkdir -p /etc/apt/sources.list.d

    mkdir -p /task /app /logs/agent /logs/verifier /logs/artifacts
    find /opt/dnah -name "__pycache__" -prune -exec rm -rf {} +

    # Invariants
    if /usr/local/bin/python3 -c "import datasets" 2>/dev/null; then echo "datasets must not be installed"; exit 1; fi
    PYTHONPATH=/opt/dnah /usr/local/bin/python3 -c "import rlm, dnah_runtime.seqtools, dnah_runtime.run_rlm"
    /opt/harbor-server/bin/python3 -c "import fastapi, uvicorn"
    mini-swe-agent --help >/dev/null

%environment
    export PYTHONPATH=/opt/dnah
    export PYTHONDONTWRITEBYTECODE=1
    export HF_HUB_OFFLINE=1
    export MSWEA_CONFIGURED=true

%labels
    org.dnaharness.image bio-sandbox
    org.dnaharness.rlms 0.1.3
    org.dnaharness.mini-swe-agent 2.4.6
